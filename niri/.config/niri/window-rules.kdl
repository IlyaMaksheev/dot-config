// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.telegram\.desktop$"# title="^Media viewer$"
    open-fullscreen false
    open-floating true
}

window-rule {
    match app-id="Telegram" title=r#"^Choose Files$"#

    open-floating true

    default-floating-position x=10 y=10 relative-to="bottom-left"
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^nm-connection-editor$"#

    open-floating true
    default-column-width { fixed 560; }
    default-window-height { fixed 520; }
}

window-rule {
    match app-id=r#"^zen$"#
    match app-id=r#"^org\.telegram\.desktop$"# 
    match app-id=r#"^discord$"# 
    match app-id="steam" title=r#"^Steam$"#

    exclude app-id=r#"^org\.telegram\.desktop$"# title="Media viewer"

    open-maximized true
    open-maximized-to-edges false
}

// Every Steam-owned window except the main client. Floating windows without
// an explicit default-floating-position open centered.
window-rule {
    match app-id="steam"
    exclude title=r#"^Steam$"#

    open-floating true
    default-column-width { proportion 0.333333; }
    default-window-height { proportion 0.333333; }
}

window-rule {
    match app-id=r#"^com\.gabm\.satty$"# title="satty"

    open-floating true
}

window-rule {
    match app-id=r#"^discord$"# title="Discord Updater"
    open-focused false
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"# title="^pi-agent$"
    open-focused false
}

window-rule {
    match app-id=r#"^org\.kde\.dolphin$"#
    open-maximized true
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
    draw-border-with-background false
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// pi-sessions hidden interactive workers. User-managed; package never edits this.
window-rule {
    match app-id=r#"^pi-sessions-worker-\."#
    open-focused false
}


window-rule {
    match app-id=r#"^vlc$"#
    open-fullscreen true
    open-maximized true
}

