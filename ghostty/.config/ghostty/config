# custom-shader = ./custom-crt-shader.glsl
# custom-shader-animation=always

gtk-single-instance = true
quit-after-last-window-closed = false

shell-integration-features=true
theme = gruvbox-dark-custom
font-family = "JetBrainsMono Nerd Font Propo"

# gtk-titlebar-style = tabs

keybind = clear

keybind = ctrl+;=toggle_command_palette

keybind = copy=copy_to_clipboard
keybind = paste=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down
